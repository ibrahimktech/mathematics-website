# -----------------------------------------------------------------------------
# Copy this file to .env.local and fill in the values.
#   Windows:  copy .env.example .env.local
# -----------------------------------------------------------------------------

# Supabase → Project Settings → Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER expose to the browser or commit this value.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of the site (used for canonical URLs, Open Graph, sitemap, RSS).
# Use http://localhost:3000 in development; your real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Optional — security
# -----------------------------------------------------------------------------
# Salt for the one-way hashes used by analytics (visitor IPs) and the security
# log. Server-only. Set it to any long random string; if unset it falls back to
# the service-role key. Changing it resets visitor de-duplication once.
#   Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ANALYTICS_IP_SALT=

# How many reverse proxies sit in front of the app. Used to pick the real client
# IP out of X-Forwarded-For (a client-controlled header) for rate limiting.
# Vercel = 1, which is the default. Only raise it if you add another proxy/CDN;
# setting it too high lets callers forge their own IP and skip rate limits.
TRUSTED_PROXY_COUNT=1

# Cloudflare Turnstile SITE key (dash.cloudflare.com -> Turnstile -> Add widget,
# mode "Managed"). Public by design — it ships in the HTML of the auth pages.
# Bot protection for sign-up, sign-in and password reset.
#
# The matching SECRET key does NOT belong here. Paste it into
#   Supabase -> Authentication -> Attack Protection -> Enable CAPTCHA protection
#   -> provider "Turnstile"
# so Supabase Auth verifies the token itself. That is what makes the check
# unskippable: it also covers a bot that ignores this app and posts straight to
# /auth/v1/signup with the public anon key. A token can only be verified once,
# so this app must never verify it as well — see lib/security/turnstile.ts.
#
# Leave this blank and the widget simply does not render, so the app still runs
# locally. Only set it once CAPTCHA is enabled in Supabase (and vice versa) —
# either half alone means every auth flow fails.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
